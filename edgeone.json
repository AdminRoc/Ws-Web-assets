{
  "headers": [
    { "source": "/*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }] },
    { "source": "/*.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }] },
    { "source": "/data/item/*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=300" }] },
    { "source": "/data/eelog-runtime-release.json", "headers": [{ "key": "Cache-Control", "value": "public, no-cache, must-revalidate" }] },
    { "source": "/*.js", "headers": [{ "key": "Cache-Control", "value": "public, no-cache, must-revalidate" }] },
    { "source": "/*.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, s-maxage=2592000" }] },
    { "source": "/icons/*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, s-maxage=2592000" }] }
  ]
}
