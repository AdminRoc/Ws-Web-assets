    {
      "id": "icon-manifest",
      "source_repository": "Ws-Web-assets",
      "source_path": "manifest.json",
      "asset_path": "manifest.json",
      "kv_key": "manifest_json",
      "required": true,
      "delivery": "kv-and-assets"
    }
  ]
}
