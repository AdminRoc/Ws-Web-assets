      "kv_key": "auction_weapons_riven_json",
      "required": true,
      "delivery": "kv-and-assets"
    },
    {
      "id": "auction-attrs-riven",
      "source_path": "data/item/auction-dicts/auction-attrs-riven.json",
      "asset_path": "data/item/auction-dicts/auction-attrs-riven.json",
      "kv_key": "auction_attrs_riven_json",
      "required": true,
      "delivery": "kv-and-assets"
    },
    {
      "id": "auction-weapons-lich",
      "source_path": "data/item/auction-dicts/auction-weapons-lich.json",
